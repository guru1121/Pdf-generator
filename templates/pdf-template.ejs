<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, Helvetica, sans-serif; color: #222; margin:0; padding:0 }
    .invoice { padding: 0 }
    .header-banner { background:#b3e5fc; padding:20px; display:flex; justify-content:space-between; align-items:center; margin-bottom:20px }
    .header-banner img { height:70px; margin-right:20px }
    .header-title { flex:1 }
    .header-title h1 { margin:0; font-size:24px; color:#333; font-weight:bold }
    .header-title p { margin:4px 0; font-size:12px; color:#555 }
    .header-title .url { font-size:11px; color:#0066cc }
    .header-right { text-align:right }
    .header-right h3 { margin:0; color:#0b74c9; font-size:18px }
    .content { padding:20px }
    .section { margin-bottom:20px }
    .flex-row { display:flex; gap:30px; margin-bottom:20px }
    .flex-col { flex:1 }
    .seller, .buyer { padding:10px; border:1px solid #e2e2e2; border-radius:4px }
    .seller h4, .buyer h4 { margin:0 0 8px 0; font-size:13px; font-weight:bold; color:#333 }
    .seller p, .buyer p { margin:4px 0; font-size:12px; line-height:1.4 }
    .seller strong, .buyer strong { display:block; font-weight:bold; margin-bottom:4px }
    .invoice-meta { display:flex; gap:30px; margin-bottom:20px; font-size:12px }
    .invoice-meta-col { flex:1 }
    .invoice-meta-col strong { display:block; margin-bottom:4px }
    .place-supply { background:#e3f2fd; padding:12px; border-left:4px solid #2196f3; margin-bottom:20px; font-size:12px }
    .invoice-items { margin:20px 0 }
    table { width:100%; border-collapse:collapse; margin:12px 0 }
    th, td { padding:10px; border:1px solid #ddd; vertical-align:top; font-size:12px }
    th { background:#e3f2fd; text-align:left; font-weight:bold; color:#0b74c9 }
    .right { text-align:right }
    .totals-section { margin-top:20px; display:flex; justify-content:flex-end }
    .totals-table { width:300px }
    .totals-table td { border:none; padding:6px 12px }
    .totals-table .label { text-align:right; font-weight:normal }
    .totals-table .total-row { border-top:2px solid #333; font-weight:bold }
    .footer-section { display:flex; justify-content:space-between; margin-top:30px; font-size:12px }
    .footer-box { flex:1; text-align:center }
    .signature-line { border-top:1px solid #333; margin-top:30px; padding-top:4px }
    .small { font-size:11px; color:#666 }
  </style>
</head>
<body>
  <div class="invoice">
    <!-- Header Banner with Logo -->
    <div class="header-banner">
      <div style="display:flex; align-items:center">
        <img src="../public/images/Indo.png" alt="Logo">
        <div class="header-title">
          <h1>Indo Dictionary Networks Private Limited</h1>
          <p>Unlocking the dictionary of networking excellence</p>
          <p>CIN : U62013MP2025PTC076601 | GSTIN : 23AAICI1972L1ZC</p>
          <p class="url">www.dictionarynetworks.in</p>
        </div>
      </div>
      <div class="header-right">
        <h3>TAX INVOICE</h3>
      </div>
    </div>

    <div class="content">
      <!-- Seller and Buyer Section -->
      <div class="flex-row">
        <div class="flex-col">
          <div class="seller">
            <h4>Seller:</h4>
            <strong>INDO DICTIONARY NETWORKS PRIVATE LIMITED</strong>
            <p>12/1, Nandbagh Sector D, Army Head Quarter, Indore,</p>
            <p>Indore, Madhya Pradesh, India - 452006</p>
            <p><strong>GSTIN :</strong> 23AAICI1972L1ZC</p>
            <p><strong>Contact:</strong></p>
            <p>info@dictionarynetworks.in</p>
            <p>+91-96636 81258</p>
          </div>
        </div>
        <div class="flex-col">
          <div class="buyer">
            <h4>Buyer:</h4>
            <strong><%= data.buyer && data.buyer.name ? data.buyer.name : 'Buyer Name' %></strong>
            <p><%= data.buyer && data.buyer.addressLine1 ? data.buyer.addressLine1 : '' %></p>
            <p><%= data.buyer && data.buyer.addressLine2 ? data.buyer.addressLine2 : '' %></p>
            <p><%= data.buyer && data.buyer.city ? data.buyer.city : '' %></p>
            <p><strong>GSTIN :</strong> <%= data.buyer && data.buyer.gstin ? data.buyer.gstin : '' %></p>
          </div>
        </div>
      </div>

      <!-- Place of Supply -->
      <div class="place-supply">
        <strong>Place of Supply :</strong> <%= data.placeOfSupply || 'Madhya Pradesh (23)' %>
      </div>

      <!-- Invoice Details -->
      <div class="invoice-meta">
        <div class="invoice-meta-col">
          <strong>Invoice Number:</strong>
          <%= data.invoiceNumber || '' %>
        </div>
        <div class="invoice-meta-col">
          <strong>Invoice Generated Date:</strong>
          <%= data.invoiceDate || '' %>
        </div>
        <div class="invoice-meta-col">
          <strong>Ref. PO Number</strong> - <%= data.refPo || '' %>
        </div>
        <div class="invoice-meta-col">
          <strong>Ref. PI Number</strong> - <%= data.refPi || '' %>
        </div>
      </div>

      <!-- Items Table -->
      <div class="invoice-items">
        <h3 style="color:#0099ff; background:#e3f2fd; padding:12px; margin:0 0 12px 0">Invoice Items</h3>
        <table>
          <thead>
            <tr>
              <th style="width:8%">Item #</th>
              <th>Description</th>
              <th style="width:12%">Quantity</th>
              <th style="width:14%">Unit Price</th>
              <th style="width:14%">Total</th>
            </tr>
          </thead>
          <tbody>
            <% let subtotal = 0; if (Array.isArray(data.items) && data.items.length) { %>
              <% data.items.forEach(function(item, idx){
                   const q = Number(item.quantity) || 0;
                   const up = Number(item.unitPrice) || 0;
                   const lineTotal = q * up;
                   subtotal += lineTotal;
              %>
                <tr>
                  <td class="right"><%= idx + 1 %></td>
                  <td><%= item.description %></td>
                  <td class="right"><%= q %></td>
                  <td class="right">INR <%= up.toLocaleString('en-IN', {maximumFractionDigits:2}) %></td>
                  <td class="right">INR <%= lineTotal.toLocaleString('en-IN', {maximumFractionDigits:2}) %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="5">No items</td></tr>
            <% } %>
          </tbody>
        </table>

        <!-- Totals -->
        <div class="totals-section">
          <table class="totals-table">
            <tr>
              <td class="label">Subtotal:</td>
              <td class="right" style="font-weight:normal">INR <%= subtotal.toLocaleString('en-IN', {maximumFractionDigits:2}) %></td>
            </tr>
            <% const gstRate = Number(data.gstRate) || 18; const gstAmount = +(subtotal * gstRate / 100).toFixed(2); %>
            <tr>
              <td class="label">GST (<%= gstRate %>%):</td>
              <td class="right" style="font-weight:normal">INR <%= gstAmount.toLocaleString('en-IN', {maximumFractionDigits:2}) %></td>
            </tr>
            <tr class="total-row">
              <td class="label">Total:</td>
              <td class="right">INR <%= (subtotal + gstAmount).toLocaleString('en-IN', {maximumFractionDigits:2}) %></td>
            </tr>
          </table>
        </div>
      </div>

      <!-- Payment Information -->
      <div class="section" style="margin-top:40px; background:#e3f2fd; padding:12px; border-radius:4px">
        <h3 style="margin:0 0 12px 0; color:#0099ff">Payment Information</h3>
        <div style="font-size:12px">
          <div><strong>Payment Method :</strong> <%= data.paymentMethod || 'Bank Transfer' %></div>
          <div><strong>Payment Date :</strong> <%= data.paymentDate || '' %></div>
        </div>
      </div>

      <!-- Footer -->
      <div class="footer-section">
        <div class="footer-box"></div>
        <div class="footer-box">
          <strong>For INDO DICTIONARY NETWORKS PRIVATE LIMITED</strong>
          <div class="signature-line">
            <div style="margin-top:4px">DIRECTOR</div>
          </div>
        </div>
      </div>

      <!-- Thank you message -->
      <div style="margin-top:30px; font-size:11px; color:#666; text-align:center">
        Thank you for your business!<br>
        If you have any questions regarding this invoice, please contact us at info@dictionarynetworks.in.
      </div>
    </div>
  </div>
</body>
</html>
